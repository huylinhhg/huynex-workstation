#!/bin/bash
# ==============================================================================
# HuyNex Clean - Automated Maintenance & System Tuning for Power-Users
# 100% Free - Khong loi font - Do RAM truoc va sau don dep
# ==============================================================================
set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${BLUE}=================================================================${NC}"
echo -e "${GREEN}   HUYNEX SYSTEM OPTIMIZER & AUTO-CLEANER (macOS) ⚡${NC}"
echo -e "${BLUE}=================================================================${NC}"

INITIAL_AVAIL=$(df -h / | awk 'NR==2 {print $4}')
echo -e "${CYAN}-> Dung luong SSD kha dung ban dau:${NC} ${YELLOW}$INITIAL_AVAIL${NC}\n"

# 1. Dong cac tien trinh chay ngam
echo -e "${CYAN}[1/7] Quet va dong cac tien trinh chay ngam chiem RAM...${NC}"
BLOAT_PROCESSES=(
    "AdobeIPCBroker"
    "CCLibrary"
    "CoreSync"
    "Adobe Desktop Service"
    "AdobeCRDaemon"
    "CleanMyMac4.HealthMonitor"
    "CleanMyMac4.Menu"
    "CleanMyMac X Updater"
    "GoogleSoftwareUpdateAgent"
    "coccoc_update"
    "Microsoft AU Daemon"
    "Microsoft Update Assistant"
)

KILLED_COUNT=0
for proc in "${BLOAT_PROCESSES[@]}"; do
    if pgrep -fi "$proc" &>/dev/null; then
        pkill -9 -fi "$proc" 2>/dev/null || true
        echo -e "  ✔ Da dong tien trinh ngam: $proc"
        ((KILLED_COUNT++)) || true
    fi
done

for pattern in "com.macpaw.CleanMyMac*" "com.google.keystone*" "com.coccoc*" "com.adobe.*" "com.microsoft.update*"; do
    for plist in "$HOME/Library/LaunchAgents"/$pattern.plist; do
        if [ -f "$plist" ]; then
            launchctl unload -w "$plist" 2>/dev/null || true
            rm -f "$plist"
            echo -e "  ✔ Da go bo LaunchAgent: $(basename "$plist")"
        fi
    done
done

# 2. Package Managers Cache
echo -e "${CYAN}[2/7] Don dep bo nho dem Package Managers (Brew, npm, pip)...${NC}"
if command -v brew &>/dev/null; then
    brew cleanup -s --prune=all &>/dev/null || true
    echo -e "  ✔ Homebrew cache cleaned"
fi
if command -v npm &>/dev/null; then
    npm cache clean --force &>/dev/null || true
    echo -e "  ✔ npm cache cleaned"
fi
if command -v pip3 &>/dev/null; then
    pip3 cache purge &>/dev/null || true
    echo -e "  ✔ pip cache cleaned"
fi

# 3. Xcode & Dev Caches
echo -e "${CYAN}[3/7] Don dep cache phat trien (Xcode, build artifacts)...${NC}"
if [ -d "$HOME/Library/Developer/Xcode/DerivedData" ]; then
    rm -rf "$HOME/Library/Developer/Xcode/DerivedData"/* 2>/dev/null || true
    echo -e "  ✔ Xcode DerivedData cleaned"
fi

# 4. Old Logs (>7 days)
echo -e "${CYAN}[4/7] Don dep log va bao cao loi cu (>7 ngay)...${NC}"
find "$HOME/Library/Logs" -type f -mtime +7 -delete 2>/dev/null || true
echo -e "  ✔ Old logs removed"

# 5. Application Caches & Temp files
echo -e "${CYAN}[5/7] Don dep temp va cache cac ung dung...${NC}"
rm -rf "$HOME/Library/Containers/com.lemon.lvoverseas/Data/Library/Caches"/* 2>/dev/null || true
rm -rf "$HOME/Library/Application Support/Zalo/temp"/* 2>/dev/null || true
rm -rf "$HOME/Library/Application Support/ZaloData/temp"/* 2>/dev/null || true
rm -rf "$HOME/Library/Caches/Google/Chrome/Default/Media Cache"/* 2>/dev/null || true
echo -e "  ✔ App caches purged"

# 6. .DS_Store
echo -e "${CYAN}[6/7] Don dep file tam .DS_Store trong workspace...${NC}"
find "$HOME/HuyNex" -name ".DS_Store" -delete 2>/dev/null || true
echo -e "  ✔ .DS_Store purged"

# 7. Trash
echo -e "${CYAN}[7/7] Don sach Thung rac (.Trash)...${NC}"
rm -rf "$HOME/.Trash"/* 2>/dev/null || true
echo -e "  ✔ Trash emptied"

FINAL_AVAIL=$(df -h / | awk 'NR==2 {print $4}')

echo -e "\n${BLUE}=================================================================${NC}"
echo -e "${GREEN}   BAO TRI HOAN TAT - HE THONG DA TOI UU${NC}"
echo -e "${BLUE}=================================================================${NC}"
echo -e "SSD kha dung: ${YELLOW}$INITIAL_AVAIL${NC} -> ${GREEN}$FINAL_AVAIL${NC}"
echo -e "Trang thai RAM thuc te:"
vm_stat | perl -ne '/page size of (\d+)/ and $size=$1; /(Pages free|Pages active|Pages inactive|Pages speculative|Pages wired down|Pages occupied by compressor):\s+(\d+)/ and $mem{$1}=$2*$size; END { printf "  • RAM thuc tu do (Free + Inactive): %.2f GB\n", ($mem{"Pages free"}+$mem{"Pages inactive"})/1024/1024/1024; printf "  • RAM nen (Compressed): %.2f GB\n", $mem{"Pages occupied by compressor"}/1024/1024/1024 }'
echo -e "${BLUE}=================================================================${NC}\n"
